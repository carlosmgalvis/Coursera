extends ../layout

block content
    a(href="/bicicletas") Volver

    br
    br
    br
    
    h1  Nueva Bicicleta

    br
    br

    form(action="/bicicletas/create", method="POST")
        .form-group
            label(for="id") ID:
            input.form-control(type="text", name="id", id="id")
        br
        .form-group
            label(for="color") Color:
            input.form-control(type="text", name="color", id="color")
        br
        .form-group
            label(for="modelo") Modelo:
            input.form-control(type="text", name="modelo", id="modelo")
        br
        .form-group
            label(for="lat") Latitud:
            input.form-control(type="text", name="lat", id="lat")
        br
        .form-group
            label(for="lng") Longitud:
            input.form-control(type="text", name="lng", id="lng")
        br
        br
        button.btn.btn-primary(type="submit") Crear Bicicleta