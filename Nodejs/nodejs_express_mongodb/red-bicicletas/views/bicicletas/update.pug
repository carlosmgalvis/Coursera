extends ../layout

block content
    a(href="/bicicletas") Volver

    br
    br
    br

    h1  Actualizar Bicicleta

    br
    br

    form(action=`/bicicletas/${bici.id}/update`, method="POST")
        .form-group
            label(for="id") ID:
            input.form-control(type="text", name="id", id="id", value=bici.id, readonly)
        br
        .form-group
            label(for="color") Color:
            input.form-control(type="text", name="color", id="color", value=bici.color)
        br
        .form-group
            label(for="modelo") Modelo:
            input.form-control(type="text", name="modelo", id="modelo", value=bici.modelo)
        br
        .form-group
            label(for="lat") Latitud:
            input.form-control(type="text", name="lat", id="lat", value=bici.ubicacion[0])
        br
        .form-group
            label(for="lng") Longitud:
            input.form-control(type="text", name="lng", id="lng", value=bici.ubicacion[1])
        br
        br
        button.btn.btn-primary(type="submit") Actualizar Bicicleta        